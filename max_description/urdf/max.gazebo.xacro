<?xml version="1.0" ?>
<robot name="max" xmlns:xacro="http://www.ros.org/wiki/xacro" >

  <xacro:property name="wheel_color" value="Gazebo/Black" />
  <xacro:property name="lidar_color" value="Gazebo/Blue" />
  <xacro:property name="camera_color" value="Gazebo/Blue" />
  
  <gazebo reference="fl_wheel_link">
    <material>${wheel_color}</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>100000.0</kp>
    <kd>5.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.2</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="fr_wheel_link">
    <material>${wheel_color}</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>100000.0</kp>
    <kd>5.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.2</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="rl_wheel_link">
    <material>${wheel_color}</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>100000.0</kp>
    <kd>5.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.2</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="rr_wheel_link">
    <material>${wheel_color}</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>100000.0</kp>
    <kd>5.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.2</maxVel>
    <fdir1>1 0 0</fdir1>
  </gazebo>

  <gazebo reference="lidar_link">
    <material>${lidar_color}</material>
  </gazebo>

  <gazebo reference="camera_link">
    <material>${camera_color}</material>
  </gazebo>

</robot>
