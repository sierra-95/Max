<?xml version="1.0"?>

<robot name="max" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <xacro:arg name="is_sim" default="true"/>
    <xacro:include filename="$(find max_description)/urdf/materials.xacro" />
    <xacro:include filename="$(find max_description)/urdf/max.gazebo.xacro" />
    <xacro:include filename="$(find max_description)/urdf/trans.xacro" />
    <xacro:include filename="$(find max_description)/urdf/ros2_control.xacro" />

    <link name="base_footprint"/>
    
    <link name="base_link">
        <inertial>
            <origin xyz="-0.008949251381261427 2.0808612371678153e-17 0.10071250738095076" rpy="0 0 0"/>
            <mass value="8.307942395442693"/>
            <inertia ixx="0.041631" iyy="0.061003" izz="0.073974" ixy="-0.0" iyz="-0.0" ixz="0.002477"/>
        </inertial>
        <visual>
            <origin xyz="0 0 -0.0425" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file://$(find max_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <link name="fl_wheel_link">
        <inertial>
            <origin xyz="4.163336342344337e-17 0.010504645034502769 0.0" rpy="0 0 0"/>
            <mass value="0.16353745126830063"/>
            <inertia ixx="8.7e-05" iyy="0.000148" izz="8.7e-05" ixy="0.0" iyz="0.0" ixz="0.0"/>
        </inertial>
        <visual>
            <origin xyz="-0.35369 -0.109 -0.0425" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file://$(find max_description)/meshes/fl_wheel_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="matte_black"/>
        </visual>
        <collision>
            <origin xyz="-0.07309 -0.109 -0.0425" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/fl_wheel_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <link name="fr_wheel_link">
        <inertial>
            <origin xyz="4.163336342344337e-17 -0.01050464503450281 -1.3877787807814457e-17" rpy="0 0 0"/>
            <mass value="0.16353745126830063"/>
            <inertia ixx="8.7e-05" iyy="0.000148" izz="8.7e-05" ixy="-0.0" iyz="-0.0" ixz="-0.0"/>
        </inertial>
        <visual>
            <origin xyz="-0.35369 0.109 -0.0425" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/fr_wheel_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="matte_black"/>
        </visual>
        <collision>
            <origin xyz="-0.07309 0.109 -0.0425" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/fr_wheel_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <link name="rl_wheel_link">
        <inertial>
            <origin xyz="5.551115123125783e-17 0.010504645034502769 -1.3877787807814457e-17" rpy="0 0 0"/>
            <mass value="0.16353745126830063"/>
            <inertia ixx="8.7e-05" iyy="0.000148" izz="8.7e-05" ixy="0.0" iyz="-0.0" ixz="-0.0"/>
        </inertial>
        <visual>
            <origin xyz="-0.1828 -0.109 -0.0425" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/rl_wheel_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="matte_black"/>
        </visual>
        <collision>
            <origin xyz="0.0978 -0.109 -0.0425" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/rl_wheel_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <link name="rr_wheel_link">
        <inertial>
            <origin xyz="5.551115123125783e-17 -0.01050464503450281 -1.3877787807814457e-17" rpy="0 0 0"/>
            <mass value="0.16353745126830063"/>
            <inertia ixx="8.7e-05" iyy="0.000148" izz="8.7e-05" ixy="-0.0" iyz="-0.0" ixz="0.0"/>
        </inertial>
        <visual>
            <origin xyz="-0.1828 0.109 -0.0425" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/rr_wheel_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="matte_black"/>
        </visual>
        <collision>
            <origin xyz="0.0978 0.109 -0.0425" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/rr_wheel_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <link name="lidar_link">
        <inertial>
            <origin xyz="1.9174124308283903e-17 6.391374769427968e-18 0.011555000000000093" rpy="0 0 0"/>
            <mass value="0.11472963638620308"/>
            <inertia ixx="4e-05" iyy="4e-05" izz="7e-05" ixy="0.0" iyz="0.0" ixz="-0.0"/>
        </inertial>
        <visual>
            <origin xyz="-0.0 -0.0 -0.204001" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/lidar_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="tech_blue"/>
        </visual>
        <collision>
            <origin xyz="-0.0 -0.0 -0.204001" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/lidar_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <link name="camera_link">
        <inertial>
            <origin xyz="0.014490312898766358 3.7392359944188856e-16 -0.008993541932510896" rpy="0 0 0"/>
            <mass value="1.7184205751165316"/>
            <inertia ixx="0.00474" iyy="0.000448" izz="0.004472" ixy="0.0" iyz="-0.0" ixz="0.0"/>
        </inertial>
        <visual>
            <origin xyz="-0.1133 -0.0 -0.144" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/camera_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="camera_accent"/>
        </visual>
        <collision>
            <origin xyz="-0.1133 -0.0 -0.144" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/camera_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.0425" rpy="0 0 0"/>
    </joint>

    <joint name="fl_joint" type="continuous">
        <origin xyz="0.07309 0.109 0" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="fl_wheel_link"/>
        <axis xyz="0.0 1.0 0.0"/>
    </joint>

    <joint name="fr_joint" type="continuous">
        <origin xyz="0.07309 -0.109 0" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="fr_wheel_link"/>
        <axis xyz="0.0 1.0 0.0"/>
    </joint>

    <joint name="rl_joint" type="continuous">
        <origin xyz="-0.0978 0.109 0" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="rl_wheel_link"/>
        <axis xyz="0.0 1.0 0.0"/>
    </joint>

    <joint name="rr_joint" type="continuous">
        <origin xyz="-0.0978 -0.109 0" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="rr_wheel_link"/>
        <axis xyz="0.0 1.0 0.0"/>
    </joint>

    <joint name="lidar_joint" type="fixed">
        <origin xyz="0.0 0.0 0.161501" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <axis xyz="0 0 1"/>
    </joint>

    <joint name="camera_joint" type="fixed">
        <origin xyz="0.1133 0.0 0.1015" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="camera_link"/>
    </joint>
</robot>