<?xml version="1.0"?>

<robot name="max" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <xacro:arg name="is_sim" default="true"/>
    <xacro:arg name="is_ignition" default="false"/>
    
    <xacro:include filename="$(find max_description)/urdf/materials.xacro" />
    <xacro:include filename="$(find max_description)/urdf/max.gazebo.xacro" />
    <xacro:include filename="$(find max_description)/urdf/trans.xacro" />
    <xacro:include filename="$(find max_description)/urdf/ros2_control.xacro" />

    <link name="base_footprint"/>
    
    <link name="base_link">
        <inertial>
            <origin xyz="0.004914987095310725 0.0 0.11525864563546669" rpy="0 0 0"/>
            <mass value="2.1411582458682883"/>
            <inertia ixx="0.015376" iyy="0.021164" izz="0.024064" ixy="-0.0" iyz="-0.0" ixz="0.000293"/>
        </inertial>
        <visual>
            <origin xyz="0 0 -0.0425" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="silver"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file://$(find max_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <link name="fl_wheel_link">
        <inertial>
            <origin xyz="4.163336342344337e-17 0.010504987657416559 -1.3877787807814457e-17" rpy="0 0 0"/>
            <mass value="0.15230338417321157"/>
            <inertia ixx="8.3e-05" iyy="0.000141" izz="8.3e-05" ixy="0.0" iyz="-0.0" ixz="-0.0"/>
        </inertial>
        <visual>
            <origin xyz="-0.07309 -0.109 -0.0425" rpy="0 0 0"/>
            <geometry>
                <mesh filename="file://$(find max_description)/meshes/fl_wheel_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="matte_black"/>
        </visual>
        <collision>
            <origin xyz="-0.07309 -0.109 -0.0425" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/fl_wheel_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <link name="fr_wheel_link">
        <inertial>
            <origin xyz="4.163336342344337e-17 -0.010504987657416545 -1.3877787807814457e-17" rpy="0 0 0"/>
            <mass value="0.15230338417321157"/>
            <inertia ixx="8.3e-05" iyy="0.000141" izz="8.3e-05" ixy="0.0" iyz="0.0" ixz="-0.0"/>
        </inertial>
        <visual>
            <origin xyz="-0.07309 0.109 -0.0425" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/fr_wheel_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="matte_black"/>
        </visual>
        <collision>
            <origin xyz="-0.07309 0.109 -0.0425" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/fr_wheel_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <link name="rl_wheel_link">
        <inertial>
            <origin xyz="6.938893903907228e-17 0.010504987657416559 0.0" rpy="0 0 0"/>
            <mass value="0.15230338417321163"/>
            <inertia ixx="8.3e-05" iyy="0.000141" izz="8.3e-05" ixy="0.0" iyz="-0.0" ixz="0.0"/>
        </inertial>
        <visual>
            <origin xyz="0.0978 -0.109 -0.0425" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/rl_wheel_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="matte_black"/>
        </visual>
        <collision>
            <origin xyz="0.0978 -0.109 -0.0425" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/rl_wheel_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <link name="rr_wheel_link">
        <inertial>
            <origin xyz="6.938893903907228e-17 -0.010504987657416559 -2.0816681711721685e-17" rpy="0 0 0"/>
            <mass value="0.15230338417321163"/>
            <inertia ixx="8.3e-05" iyy="0.000141" izz="8.3e-05" ixy="-0.0" iyz="0.0" ixz="0.0"/>
        </inertial>
        <visual>
            <origin xyz="0.0978 0.109 -0.0425" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/rr_wheel_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="matte_black"/>
        </visual>
        <collision>
            <origin xyz="0.0978 0.109 -0.0425" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/rr_wheel_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <link name="lidar_link">
        <inertial>
            <origin xyz="1.9174124308283903e-17 6.391374769427968e-18 0.011555000000000065" rpy="0 0 0"/>
            <mass value="0.09427396478246144"/>
            <inertia ixx="3.3e-05" iyy="3.3e-05" izz="5.8e-05" ixy="0.0" iyz="0.0" ixz="-0.0"/>
        </inertial>
        <visual>
            <origin xyz="-0.0 -0.0 -0.204001" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/lidar_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="tech_blue"/>
        </visual>
        <collision>
            <origin xyz="-0.0 -0.0 -0.204001" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/lidar_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <link name="camera_link">
        <inertial>
            <origin xyz="0.014490312898766358 3.7392359944188856e-16 -0.008993541932510896" rpy="0 0 0"/>
            <mass value="0.23204150441063995"/>
            <inertia ixx="0.00064" iyy="6e-05" izz="0.000604" ixy="0.0" iyz="-0.0" ixz="0.0"/>
        </inertial>
        <visual>
            <origin xyz="-0.1133 -0.0 -0.144" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/camera_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="camera_accent"/>
        </visual>
        <collision>
            <origin xyz="-0.1133 -0.0 -0.144" rpy="0 0 0"/>
            <geometry>
            <mesh filename="file://$(find max_description)/meshes/camera_link.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.0425" rpy="0 0 0"/>
    </joint>

    <joint name="fl_joint" type="continuous">
        <origin xyz="0.07309 0.109 0" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="fl_wheel_link"/>
        <axis xyz="0.0 1.0 0.0"/>
    </joint>

    <joint name="fr_joint" type="continuous">
        <origin xyz="0.07309 -0.109 0" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="fr_wheel_link"/>
        <axis xyz="0.0 1.0 0.0"/>
    </joint>

    <joint name="rl_joint" type="continuous">
        <origin xyz="-0.0978 0.109 0" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="rl_wheel_link"/>
        <axis xyz="0.0 1.0 0.0"/>
    </joint>

    <joint name="rr_joint" type="continuous">
        <origin xyz="-0.0978 -0.109 0" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="rr_wheel_link"/>
        <axis xyz="0.0 1.0 0.0"/>
    </joint>

    <joint name="lidar_joint" type="fixed">
        <origin xyz="0.0 0.0 0.161501" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <axis xyz="0 0 1"/>
    </joint>

    <joint name="camera_joint" type="fixed">
        <origin xyz="0.1133 0.0 0.1015" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="camera_link"/>
    </joint>
</robot>